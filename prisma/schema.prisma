generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// NextAuth required models
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  walletAddress       String?   @unique
  walletType          String?   // "managed" | "external"
  encryptedPrivateKey String?   // AES-256-GCM encrypted private key
  encryptedMnemonic   String?   // AES-256-GCM encrypted mnemonic (null for private-key imports)
  createdAt           DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  paymentLinks   PaymentLink[]
  payments       Payment[]
  invoices       Invoice[]
  vaults         ComplianceVault[]
  payrollBatches PayrollBatch[]
  agents         Agent[]
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// App models
// ============================================================

model PaymentLink {
  id               String   @id @default(cuid())
  userId           String
  code             String   @unique
  name             String?
  network          String   @default("celo")
  sourceToken      String   @default("USDC")
  destStable       String   @default("USDC")
  amountMin        Float?
  amountMax        Float?
  recipientAddress String?
  status           String   @default("active")
  totalVolume      Float    @default(0)
  transactions     Int      @default(0)
  hspCheckoutUrl   String?
  hspMandateId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, createdAt])
  @@index([hspMandateId])
}

model Payment {
  id               String   @id @default(cuid())
  userId           String?
  paymentLinkId    String?
  agentId          String?
  payer            String?
  amount           Float
  currency         String   @default("USDC")
  token            String?
  txHash           String?
  status           String   @default("pending")
  network          String   @default("celo")
  complianceScore  Int      @default(0)
  kycPassed        Boolean  @default(false)
  sanctionsChecked Boolean  @default(false)
  gasUsed          String?
  payerAddress     String?
  recipientAddress String?
  memo             String?
  paymentType      String?  @default("standard")
  createdAt        DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id])
  agent       Agent?       @relation(fields: [agentId], references: [id])

  @@index([paymentLinkId, userId])
}

model Invoice {
  id               String    @id @default(cuid())
  userId           String
  invoiceNumber    String    @unique
  agentId          String?
  agentName        String?
  issuedTo         String?
  issuedToAddress  String?
  amount           Float
  subtotal         Float?
  currency         String    @default("USDC")
  network          String    @default("celo")
  status           String    @default("draft")
  description      String?
  notes            String?
  lineItems        Json?
  issueDate        DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  txHash           String?
  complianceStatus String    @default("pending")
  paymentLinkCode  String?
  hspCheckoutUrl   String?
  hspMandateId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id])

  @@index([hspMandateId])
}

model ComplianceVault {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  status              String   @default("active")
  riskScore           Int      @default(0)
  totalVolume         Float    @default(0)
  monthlyTransactions Int      @default(0)
  policies            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayrollBatch {
  id          String    @id @default(cuid())
  userId      String
  name        String
  totalAmount Float
  currency    String    @default("USDC")
  status      String    @default("pending")
  network     String    @default("celo")
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients PayrollRecipient[]
}

model PayrollRecipient {
  id            String  @id @default(cuid())
  batchId       String
  name          String
  email         String?
  walletAddress String
  amount        Float
  currency      String  @default("USDC")
  status        String  @default("pending")
  kycStatus     String  @default("pending")
  country       String?
  txHash        String?

  batch PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Agent {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  description          String?
  walletAddress        String?
  capabilities         Json     @default("[]")
  status               String   @default("active")
  totalEarned          Float    @default(0)
  invoiceCount         Int      @default(0)
  hspMultipayMandateId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments Payment[]
  rules    AgentRule[]
}

model AgentRule {
  id        String    @id @default(cuid())
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String    // 'scheduled' | 'conditional' | 'multistep'
  config    Json
  status    String    @default("active")
  lastRun   DateTime?
  nextRun   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityId   String?
  entityType String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}
