# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/flowlink
DIRECT_URL=postgresql://user:password@host:5432/flowlink

# ============================================================
# Auth
# ============================================================
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://flowlink.ink

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=https://flowlink.ink
NEXT_PUBLIC_API_URL=https://flowlink.ink

# ============================================================
# HashKey Chain
# ============================================================
NEXT_PUBLIC_HASHKEY_TESTNET_RPC=https://hashkeychain-testnet.alt.technology
NEXT_PUBLIC_FLOWLINK_CONTRACT_HASHKEY_TESTNET=0x...
NEXT_PUBLIC_FLOWLINK_CONTRACT_HASHKEY_MAINNET=0x...

# ============================================================
# Wallets / Keys
# ============================================================
DEPLOYER_MNEMONIC=word1 word2 word3 ... word12
WALLET_ENCRYPTION_KEY=64_char_hex_string_here

# ============================================================
# HashKey Settlement Protocol (HSP)
# Obtain credentials from the HSP merchant portal:
#   https://merchant.hsp.hashkey.com
# ============================================================
HSP_APP_KEY=your_hsp_app_key_here
HSP_APP_SECRET=your_hsp_app_secret_here
HSP_BASE_URL=https://api-testnet.hsp.hashkey.com
HSP_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================
# AI Providers (priority: Moonshot → Anthropic → Ollama)
# ============================================================
# Moonshot AI (primary) — get key at https://platform.moonshot.cn
MOONSHOT_API_KEY=sk-your_moonshot_key_here
# Optional: moonshot-v1-8k | moonshot-v1-32k | moonshot-v1-128k (default: moonshot-v1-8k)
MOONSHOT_MODEL=moonshot-v1-8k

# Anthropic Claude (secondary fallback)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Ollama (local fallback — runs without any key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
